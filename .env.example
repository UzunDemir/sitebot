# ── Supabase ───────────────────────────────────────────────────
# Supabase → Connect (вкладка Server) или Settings → API:
# возьмите Project URL и секретный серверный ключ.
SUPABASE_URL=https://your-project-ref.supabase.co
# Новое имя серверного ключа в дашборде — SUPABASE_SECRET_KEY (старое: service_role).
# Приложение принимает оба имени переменной.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── DeepSeek (platform.deepseek.com → API keys) ────────────────
DEEPSEEK_API_KEY=sk-...

# ── Google AI Studio (aistudio.google.com → Get API key) ───────
# Бесплатный ключ. Используется ТОЛЬКО для эмбеддингов (RAG-векторы).
GOOGLE_GENERATIVE_AI_API_KEY=...

# ── Embedding provider (сменный слой) ──────────────────────────
EMBEDDING_PROVIDER=google
